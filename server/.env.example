# Server
PORT=5000

# Local development database. Set MONGODB_URL or MONGO_URI for MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/hourglass

# --- Personal / sensitive local data (do not commit) ---
# Your project names, progress, stars, and to-do topics live here:
DATA_DIR=data
PROJECTS_FILE=projects.json
# Auth accounts + sessions (file mode) also live under DATA_DIR as users.json
